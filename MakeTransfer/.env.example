# Firebase Web App configuration is stored in firebase-applet-config.json.
# Set this only for the Firebase Hosting build after your Render URL is known.
# On Render, leave it blank so the frontend calls the same-origin /api routes.
VITE_API_URL=

# Optional stable secret for password-protected access tokens.
# Configure this as a secret environment variable in Render.
SESSION_SECRET=replace-with-a-long-random-secret

# Public Render service URL (Render sets RENDER_EXTERNAL_URL automatically).
APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
